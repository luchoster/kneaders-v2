{
  "name": "kneaders",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @kneaders/web dev",
    "dev:studio": "pnpm --filter @kneaders/studio dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "seed:export": "pnpm --filter @kneaders/studio seed:export"
  },
  "devDependencies": {
    "turbo": "^2.11.5",
    "typescript": "^5.9.3"
  }
}
