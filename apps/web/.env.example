# Leave the project ID empty to render the built-in seed content (no CMS required).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
# Optional: read token for drafts/private datasets
SANITY_API_READ_TOKEN=
# Required for form submissions (POST /api/forms): a Sanity token with write access
# (Editor role). Server-only, never expose it with a NEXT_PUBLIC_ prefix.
SANITY_API_WRITE_TOKEN=
